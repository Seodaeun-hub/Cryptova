APP_NAME=Cryptova
APP_ENV=local

# MySQL password must be URL-encoded if it contains reserved URL characters.
DATABASE_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/cryptova_db

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Used to encrypt exchange API credentials stored by the application.
ENCRYPTION_KEY=

AI_SERVER_URL=http://127.0.0.1:8001
AUTO_TRADING_INTERVAL_MINUTES=60

# Comma-separated frontend origins. Add the deployed frontend URL here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: when blank, signal explanations use the local fallback template.
GEMINI_API_KEY=
EXPLANATION_MODEL=gemini-2.5-flash
