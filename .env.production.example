# 서버 전용 파일입니다. 실제 값은 .env.production에만 넣고 Git에 올리지 마세요.
# MYSQL 비밀번호에는 영문, 숫자만 사용하면 DATABASE_URL 인코딩 문제가 없습니다.
MYSQL_DATABASE=cryptova_db
MYSQL_USER=cryptova
MYSQL_PASSWORD=replace-with-alphanumeric-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-alphanumeric-password

JWT_SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-fernet-key

# UI와 API가 같은 주소(/api)로 동작하므로 배포 주소를 적어 둡니다.
CORS_ORIGINS=http://YOUR_EXTERNAL_IP

# 선택 사항: 비워 두면 설명은 프로젝트의 기본 템플릿을 사용합니다.
GEMINI_API_KEY=
MARKETAUX_API_KEY=
